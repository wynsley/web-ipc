meta {
  name: Iniciar sesion JWT
  type: http
  seq: 2
}

post {
  url: http://127.0.0.1:3000/api/v1/auth/login
  body: json
  auth: none
}

headers {
  X-IPC-Client: admin
  Content-Type: application/json
}

body:json {
  {
    "email": "yeyo@gmail.com",
    "password": "yerson123456789"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("accessToken", res.getBody().data.accessToken);
    bru.setVar("csrfToken", res.getBody().data.csrfToken);
  }
}

meta {
  name: Mi sesion JWT
  type: http
  seq: 4
}

get {
  url: http://127.0.0.1:3000/api/v1/auth/me
  body: none
  auth: none
}

headers {
  X-IPC-Client: admin
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("csrfToken", res.getBody().data.csrfToken);
  }
}

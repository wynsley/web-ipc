meta {
  name: Tomar consulta libre
  type: http
  seq: 29
}
post {
  url: http://127.0.0.1:3000/api/v1/admin/inquiries/{{inquiryId}}/claim
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  X-IPC-Client: admin
  Authorization: Bearer {{accessToken}}
  X-CSRF-Token: {{csrfToken}}
}
body:json {
  {
    "version": {{inquiryVersion}}
  }
}
script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("inquiryVersion", res.getBody().data.version);
  }
}

meta {
  name: Cerrar sesion
  type: http
  seq: 8
}

post {
  url: http://127.0.0.1:3000/api/v1/auth/logout
  body: json
  auth: none
}

headers {
  X-IPC-Client: admin
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {}
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar("accessToken", "");
    bru.setVar("csrfToken", "");
  }
}

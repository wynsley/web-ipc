meta {
  name: Renovar JWT y rotar refresh
  type: http
  seq: 7
}

post {
  url: http://127.0.0.1:3000/api/v1/auth/refresh
  body: json
  auth: none
}

headers {
  X-IPC-Client: admin
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("accessToken", res.getBody().data.accessToken);
    bru.setVar("csrfToken", res.getBody().data.csrfToken);
  }
}

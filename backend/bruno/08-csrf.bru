meta {
  name: Recuperar CSRF tras recarga
  type: http
  seq: 3
}

get {
  url: http://127.0.0.1:3000/api/v1/auth/csrf
  body: none
  auth: none
}

headers {
  X-IPC-Client: admin
  Content-Type: application/json
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("csrfToken", res.getBody().data.csrfToken);
  }
}

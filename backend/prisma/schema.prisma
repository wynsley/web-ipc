generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  admin
  admissions
  events
}

model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(254)
  passwordHash String
  role         AdminRole
  isActive     Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  mfaSecret     String?
  mfaLastStep   Int?
  mfaChallenges MfaChallenge[]
  recoveryCodes RecoveryCode[]
  resetHash       String?   @unique @db.Char(64)
  resetExpiresAt  DateTime? @db.Timestamptz(3)
  resetMfa        Boolean   @default(false)

  sessions    Session[]
  activations Activation[]

  @@map("admins")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  adminId    String    @db.Uuid
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  @@index([adminId])
  @@index([expiresAt])
  @@map("sessions")
}

model Activation {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.Char(64)
  adminId   String    @db.Uuid
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  @@index([adminId])
  @@map("activations")
}

model Image {
  id        String   @id @default(uuid()) @db.Uuid
  data      Bytes?
  storageKey String? @unique @db.VarChar(80)
  orphanedAt DateTime? @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("images")
}

model Event {
  status String @default("scheduled") @db.VarChar(16)
  scheduleNotice String? @db.VarChar(500)
  previousStartsAt DateTime? @db.Timestamptz(3)
  previousEndsAt DateTime? @db.Timestamptz(3)
  changes EventChange[]
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(160)
  description String   @db.VarChar(2000)
  location    String   @db.VarChar(200)
  endsAt DateTime? @db.Timestamptz(3)
  startsAt    DateTime @db.Timestamptz(3)
  imageCrop   Json     @default("{\"x\":50,\"y\":50,\"zoom\":1}")
  imageUrl    String?  @db.VarChar(2048)
  highlights  String[] @default([])
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  version     Int      @default(1)

  @@index([published, startsAt, id])
  @@map("events")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  targetId  String?  @db.Uuid
  action    String   @db.VarChar(80)
  requestId String   @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@map("audit_logs")
}

model AuthRateLimit {
  key       String   @id @db.Char(64)
  hits      Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.Char(64)
  sessionId String    @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model MfaChallenge {
  id              String    @id @default(uuid()) @db.Uuid
  tokenHash       String    @unique @db.Char(64)
  adminId         String    @db.Uuid
  admin           Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  passwordVersion String    @db.Char(64)
  pendingSecret   String?
  oldHash         String?
  expiresAt       DateTime  @db.Timestamptz(3)
  usedAt          DateTime? @db.Timestamptz(3)

  @@index([adminId])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

model RecoveryCode {
  id        String @id @default(uuid()) @db.Uuid
  adminId   String @db.Uuid
  admin     Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String @unique @db.Char(64)

  @@index([adminId])
  @@map("recovery_codes")
}

model EventChange {
 id String @id @default(uuid()) @db.Uuid
 eventId String @db.Uuid
 event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
 action String @db.VarChar(32)
 reason String @db.VarChar(500)
 before Json
 after Json
 actorId String @db.Uuid
 actorName String @db.VarChar(100)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([eventId, createdAt])
 @@map("event_changes")
}

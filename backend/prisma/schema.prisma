generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  admin
  admissions
  events
}

model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(254)
  passwordHash String
  role         AdminRole
  isActive     Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  sessions    Session[]
  activations Activation[]

  @@map("admins")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  adminId    String    @db.Uuid
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  @@index([adminId])
  @@index([expiresAt])
  @@map("sessions")
}

model Activation {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.Char(64)
  adminId   String    @db.Uuid
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  @@index([adminId])
  @@map("activations")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  targetId  String?  @db.Uuid
  action    String   @db.VarChar(80)
  requestId String   @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@map("audit_logs")
}

model AuthRateLimit {
  key       String   @id @db.Char(64)
  hits      Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @db.Char(64)
  sessionId String    @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  @@index([sessionId])
  @@map("refresh_tokens")
}
